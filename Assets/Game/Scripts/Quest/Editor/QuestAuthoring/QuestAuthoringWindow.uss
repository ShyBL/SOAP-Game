.window-root {
    flex-grow: 1;
    display: flex;
}

.split-view-container {
    flex-grow: 1;
}

.split-view-container-vertical {
    flex-grow: 1;
}

.npc-pane-placeholder {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: var(--unity-colors-label-text-dim, gray);
    white-space: normal;
}

.pane-container {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    background-color: var(--unity-colors-window-background);
    border-right-width: 1px;
    border-right-color: var(--unity-colors-default-border);
}

.pane-header {
    -unity-font-style: bold;
    padding: 6px;
    background-color: var(--unity-colors-default-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.pane-content {
    flex-grow: 1;
    padding: 4px;
}

.pane-footer-btn {
    margin: 4px;
    padding: 4px;
}
